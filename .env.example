# Everything below is optional. The app runs fully with none of this set:
# the deterministic engine, khata, tax, forecast and reconciliation are
# all offline code, and data is stored in a local JSON file.

# Gemini text generation (get one at https://aistudio.google.com/apikey).
# This is the reasoning layer for the text chat path and the voice agent's
# tool calling. Without it, chat and voice show a clear inline message
# instead of failing silently.
GEMINI_API_KEY=

# Optional explicit text-model override, tried first, ahead of the
# built-in fallback chain, never in place of it.
GEMINI_MODEL=

# Sarvam (get one at https://dashboard.sarvam.ai) provides speech to text
# and text to speech for the voice agent, chosen for strong Hindi and
# Hinglish support. Without it, voice input falls back to typed text.
SARVAM_API_KEY=

# OpenRouter (get one at https://openrouter.ai/settings/keys) is a last
# resort fallback for tool calling, used only if every model in the
# Gemini text chain fails. Optional; the app works without it, just with
# one less layer of resilience.
OPENROUTER_API_KEY=

# Firestore persistence. Without these three, the app falls back
# automatically to the local file store. Use a service account scoped
# to roles/datastore.user only.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
